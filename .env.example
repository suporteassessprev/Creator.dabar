# Copy this file to .env and fill in real values

# Database (SQLite local; switch to "postgresql://..." for production)
DATABASE_URL="file:./dev.db"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-strong-random-secret"

# Initial admin (used by prisma/seed.ts on first run)
# In production, ADMIN_PASSWORD is REQUIRED — the seed refuses to run with the default.
ADMIN_EMAIL="admin@viralpost.local"
ADMIN_PASSWORD="change-me-to-a-strong-password"
ADMIN_NAME="Admin"

# Google Gemini — required for AI generation
# Obtain at: https://aistudio.google.com/app/apikey
# The key is server-only; the client never sees it and the API ignores client-supplied keys.
GEMINI_API_KEY=

# Public app URL — used for emails, Stripe callbacks, password reset links
NEXT_PUBLIC_APP_URL=https://creator-dabar-seven.vercel.app
