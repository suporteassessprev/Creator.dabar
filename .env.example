# Copy this file to .env and fill in real values

# Database (SQLite local; switch to "postgresql://..." for production)
DATABASE_URL="file:./dev.db"

# Auth — generate with: openssl rand -base64 48
JWT_SECRET="change-me-to-a-strong-random-secret"

# Initial admin (used by prisma/seed.ts on first run)
ADMIN_EMAIL="admin@viralpost.local"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"
