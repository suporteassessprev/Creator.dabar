# ─── Copie este arquivo para .env.local e preencha com seus valores ───────────

# ── Banco de dados ─────────────────────────────────────────────────────────────
# Dev: SQLite (arquivo na raiz do projeto).
# IMPORTANTE: Se existir `prisma/dev.db`, delete-o — ele é um artefato de migração
# antiga. O arquivo ativo é sempre ./dev.db (raiz), pois o Prisma resolve o path
# relativo ao CWD (diretório onde `next dev` é executado).
# Em produção, troque por PostgreSQL: DATABASE_URL="postgresql://user:pass@host/db"
DATABASE_URL="file:./dev.db"

# ── Auth (JWT) ─────────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
JWT_SECRET=seu_segredo_jwt_aqui_minimo_32_chars

# ── URL da aplicação ───────────────────────────────────────────────────────────
# Usada em server routes (emails, Stripe callbacks, links de reset de senha).
# Em produção (Vercel): https://creator-dabar-seven.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Google Gemini ──────────────────────────────────────────────────────────────
# Obtenha em: https://aistudio.google.com/app/apikey
# OBRIGATÓRIO em produção — a chave é exclusivamente do servidor.
# A API rejeita qualquer chave enviada pelo cliente.
GEMINI_API_KEY=sua_chave_gemini_aqui

# ── Stripe ─────────────────────────────────────────────────────────────────────
# Dashboard: https://dashboard.stripe.com/developers
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# IDs dos preços no Stripe (crie produtos em: https://dashboard.stripe.com/products)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_BUSINESS_PRICE_ID=price_...

# ── Resend (email transacional) ────────────────────────────────────────────────
# Crie conta gratuita em: https://resend.com
# Se não definido, emails são apenas logados no console (modo dev)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@seudominio.com

# ── Admin ──────────────────────────────────────────────────────────────────────
# ADMIN_PASSWORD é OBRIGATÓRIO em produção — o seed se recusa a usar o default.
# Gere com: openssl rand -base64 24
ADMIN_EMAIL=admin@seudominio.com
ADMIN_PASSWORD=
ADMIN_NAME=Admin
